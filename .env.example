# Local development (Docker Postgres on port 5434)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/qauto_cafe?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/qauto_cafe?schema=public"

# --- Supabase Storage (menu images — recommended for production) ---
# SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_STORAGE_BUCKET="menu-images"
# SUPABASE_ANON_KEY="your-anon-key"

# --- Production: Vercel (web + API) + Supabase ---
# See deploy/vercel.env.example and deploy/supabase.env.example
#
# Vercel (apps/web — Root Directory: apps/web):
# NEXT_PUBLIC_API_URL=/api/v1
# DATABASE_URL / DIRECT_URL → Supabase session pooler
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET / TERMINAL_ENROLLMENT_SECRET
# CORS_ORIGIN=https://your-app.vercel.app
#
# Local dev with separate API process (default npm run dev):
# API_PROXY_TARGET=http://localhost:3001
# NEXT_PUBLIC_WS_URL=http://localhost:3001/ws
JWT_ACCESS_SECRET="dev-access-secret-change-in-production"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production"
TERMINAL_ENROLLMENT_SECRET="dev-terminal-enrollment-secret"
PORT=3001
CORS_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="/api/v1"
NEXT_PUBLIC_WS_URL="http://localhost:3001/ws"

# Optional
# AUDIT_RETENTION_DAYS=365
# HEALTH_CHECK_SECRET="set-in-production-for-detailed-health-endpoint"

# --- Supabase Postgres (alternative to local Docker) ---
# DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?schema=public"
# DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?schema=public"
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD="generate-a-strong-password"
# POSTGRES_DB=qauto_cafe
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@postgres:5432/qauto_cafe?schema=public"
# JWT_ACCESS_SECRET="generate-a-strong-random-secret"
# JWT_REFRESH_SECRET="generate-another-strong-random-secret"
# TERMINAL_ENROLLMENT_SECRET="generate-terminal-enrollment-secret-min-16-chars"
# HEALTH_CHECK_SECRET="optional-token-for-/health-details"
# PORT=3001
# CORS_ORIGIN="https://cafe.yourdomain.com"
# NEXT_PUBLIC_API_URL="https://api.cafe.yourdomain.com/api/v1"
# NEXT_PUBLIC_WS_URL="https://api.cafe.yourdomain.com/ws"
# NODE_ENV=production
