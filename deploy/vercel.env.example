# Vercel → Project Settings → Environment Variables (Production + Preview)
# Root Directory: apps/web
# Enable: "Include source files outside of the Root Directory in the Build Step"
#
# Production uses Vercel colocated API (NestJS serverless) + Supabase Postgres/Storage.
# No Railway or separate API host required.

# Same-origin API (required)
NEXT_PUBLIC_API_URL=/api/v1

# --- Supabase (required) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=menu-images
# Optional public key if you add client-side Supabase later
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Database (Supabase session pooler, IPv4) ---
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?schema=public
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?schema=public

# --- Auth / API secrets (required) ---
JWT_ACCESS_SECRET=generate-a-strong-random-secret-min-32-chars
JWT_REFRESH_SECRET=generate-another-strong-random-secret-min-32-chars
TERMINAL_ENROLLMENT_SECRET=generate-terminal-enrollment-secret-min-16-chars
HEALTH_CHECK_SECRET=optional-token-for-detailed-health-endpoint

# Your Vercel web URL (no trailing slash)
CORS_ORIGIN=https://YOUR-APP.vercel.app

# WebSockets are disabled on Vercel; kitchen/orders use polling (leave unset or empty)
# NEXT_PUBLIC_WS_URL=

# --- Local dev only (do not set on Vercel) ---
# API_PROXY_TARGET=http://localhost:3001
