# Vercel → Project Settings → Environment Variables (Production + Preview)
# Root Directory in Vercel dashboard: apps/web
# Enable: "Include source files outside of the Root Directory in the Build Step"

# Same-origin API proxy (required)
NEXT_PUBLIC_API_URL=/api/v1

# Railway (or other) public API URL — no trailing slash
# Set before build; changing it requires a redeploy
API_PROXY_TARGET=https://YOUR-API.up.railway.app

# WebSocket — direct to API host (not proxied through Vercel)
NEXT_PUBLIC_WS_URL=https://YOUR-API.up.railway.app/ws
