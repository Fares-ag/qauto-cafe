# Supabase platform setup for QAuto Café
#
# 1. Create a Supabase project (or use existing)
# 2. Apply Prisma migrations: npx prisma migrate deploy
# 3. Apply storage bucket SQL (Supabase SQL editor or CLI):
#    supabase/migrations/20250623100000_menu_images_bucket.sql
# 4. Copy connection strings from Supabase → Settings → Database
# 5. Copy SUPABASE_URL + service role key from Settings → API
# 6. Set all variables in Vercel (see deploy/vercel.env.example)

# Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service role key — server-side only (Vercel env, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public anon key — optional for future client-side Supabase features
SUPABASE_ANON_KEY=your-anon-key

# Storage bucket for menu item images (created by supabase/migrations SQL)
SUPABASE_STORAGE_BUCKET=menu-images

# Postgres (session pooler recommended for serverless/Vercel)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?schema=public
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?schema=public
